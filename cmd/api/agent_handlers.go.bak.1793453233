package main

import (
	"encoding/json"
	"fmt"
	"net/http"
	"os"

	"github.com/gin-gonic/gin"
)

// AgentSummary فقط اطلاعات عمومی و مجاز را برمی‌گرداند
type AgentSummary struct {
	ID          string `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description"`
	Status      string `json:"status"`
}

// setupAgentRoutes امضای آن با main.go هماهنگ است (error برمی‌گرداند)
func setupAgentRoutes(r *gin.Engine) error {
	if r == nil {
		return fmt.Errorf("gin engine is nil")
	}

	r.GET("/api/v1/agents/status", func(c *gin.Context) {
		paths := []string{"./data/agents_registry.json", "./cmd/agent-node/agents_registry.json"}
		var data []byte
		var err error

		for _, p := range paths {
			data, err = os.ReadFile(p)
			if err == nil {
				break
			}
		}

		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Registry file not found"})
			return
		}

		var rawAgents []map[string]interface{}
		if err := json.Unmarshal(data, &rawAgents); err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Invalid JSON format"})
			return
		}

		var agents []AgentSummary
		for _, a := range rawAgents {
			id, _ := a["id"].(string)
			name, _ := a["name"].(string)
			desc, _ := a["description"].(string)
			if id != "" {
				agents = append(agents, AgentSummary{
					ID: id, Name: name, Description: desc, Status: "Active",
				})
			}
		}

		c.JSON(http.StatusOK, gin.H{
			"total_registered": len(agents),
			"consensus_nodes":  7,
			"consensus_hash":   "3ac449e02f8e6410...",
			"agents":           agents,
		})
	})

	return nil
}

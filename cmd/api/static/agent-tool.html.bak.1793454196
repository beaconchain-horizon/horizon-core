<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horizon Core | Internal Agent Tool</title>
    <style>
        :root { --bg: #0d1117; --panel: #161b22; --border: #30363d; --text: #c9d1d9; --muted: #8b949e; --accent: #58a6ff; --green: #3fb950; --red: #f85149; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); margin: 0; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
        nav { display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; border-bottom: 1px solid var(--border); background: #0d1117; }
        nav .brand { font-size: 18px; font-weight: bold; color: #fff; }
        nav ul { list-style: none; display: flex; gap: 20px; margin: 0; padding: 0; }
        nav ul li a { color: var(--text); text-decoration: none; font-weight: 500; font-size: 14px; }
        nav ul li a:hover, nav ul li a.active { color: var(--accent); }
        .container { display: flex; flex: 1; overflow: hidden; padding: 20px; gap: 20px; }
        .sidebar { width: 280px; display: flex; flex-direction: column; gap: 15px; }
        .status-card { background: var(--panel); padding: 15px; border-radius: 8px; border: 1px solid var(--border); }
        .status-card h3 { margin: 0 0 5px 0; font-size: 12px; color: var(--muted); text-transform: uppercase; }
        .status-card .val { font-size: 22px; font-weight: bold; color: var(--accent); }
        .status-card .green { color: var(--green); }
        .command-center { flex: 1; display: flex; gap: 20px; }
        .command-box { flex: 1; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 25px; display: flex; flex-direction: column; }
        .command-box h2 { color: var(--accent); margin-top: 0; font-size: 20px; }
        label { font-size: 13px; color: var(--muted); margin-bottom: 5px; display: block; }
        select, textarea { width: 100%; padding: 12px; margin-bottom: 15px; border-radius: 8px; border: 1px solid var(--border); background: #0d1117; color: #fff; font-family: monospace; resize: none; box-sizing: border-box; }
        select:focus, textarea:focus { outline: none; border-color: var(--accent); }
        .btn { padding: 15px; background: var(--green); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 16px; margin-top: auto; }
        .btn:hover { background: #2ea043; }
        .btn:disabled { background: #30363d; cursor: not-allowed; }
        .output-box { width: 40%; background: #000; border: 1px solid var(--border); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; }
        .output-box h3 { margin-top: 0; color: var(--green); font-family: monospace; font-size: 16px; }
        .log { flex: 1; overflow-y: auto; font-family: monospace; font-size: 13px; }
        .log-item { margin-bottom: 12px; border-bottom: 1px solid #21262d; padding-bottom: 12px; }
        .log-time { color: var(--muted); font-size: 11px; margin-bottom: 4px; }
        .log-success { color: var(--green); }
        .log-error { color: var(--red); }
    </style>
</head>
<body>
    <nav>
        <div class="brand">🔭 HORIZON CORE</div>
        <ul>
            <li><a href="explorer.html">Explorer</a></li>
            <li><a href="pricing.html">Pricing</a></li>
            <li><a href="agent-tool.html" class="active">Agent Tool</a></li>
            <li><a href="https://github.com/beaconchain-horizon" target="_blank">GitHub</a></li>
        </ul>
    </nav>
    <div class="container">
        <div class="sidebar">
            <div class="status-card"><h3>Chain Height</h3><div class="val" id="height">--</div></div>
            <div class="status-card"><h3>Agent License</h3><div class="val green">1,000,000,000 TX</div></div>
            <div class="status-card"><h3>Active Army</h3><div class="val green">358 Agents</div></div>
            <div class="status-card"><h3>Command Authority</h3><div class="val green">Mahdi Amolimoghaddam</div></div>
        </div>
        <div class="command-center">
            <div class="command-box">
                <h2>👼 Internal Agent Tool</h2>
                <p style="color: var(--muted); font-size: 14px;">Dispatch commands to the army. They are fed by Horizon Core API & License.</p>
                <label>Target Agent</label>
                <select id="agent">
                    <option value="engineering-frontend-developer">Frontend Developer</option>
                    <option value="engineering-backend-architect">Backend Architect</option>
                    <option value="engineering-security-architect">Security Architect</option>
                    <option value="engineering-ai-engineer">AI Engineer</option>
                    <option value="engineering-devops-automator">DevOps Automator</option>
                </select>
                <label>Command (Natural Language)</label>
                <textarea id="command" rows="6" placeholder="e.g., Design a quantum-resistant security layer..."></textarea>
                <button class="btn" id="btn" onclick="sendCommand()">🚀 Execute Command</button>
            </div>
            <div class="output-box">
                <h3>📡 Live Output</h3>
                <div class="log" id="log">
                    <div class="log-item">
                        <div class="log-time">System Ready</div>
                        <div class="log-success">✅ Awaiting orders, Commander Mahdi.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        async function fetchHeight() {
            try {
                const res = await fetch('http://localhost:8080/api/v1/chain/info');
                const data = await res.json();
                document.getElementById('height').innerText = data.height;
            } catch (e) {}
        }
        fetchHeight();
        setInterval(fetchHeight, 5000);
        async function sendCommand() {
            const agent = document.getElementById('agent').value;
            const cmd = document.getElementById('command').value;
            const btn = document.getElementById('btn');
            const log = document.getElementById('log');
            if (!cmd) return alert("Please enter a command.");
            btn.disabled = true;
            btn.innerText = "Dispatching...";
            const time = new Date().toLocaleTimeString();
            log.innerHTML += `<div class="log-item"><div class="log-time">${time}</div><div>⏳ Sending to [${agent}]...</div></div>`;
            log.scrollTop = log.scrollHeight;
            try {
                const res = await fetch('http://localhost:9008/api/v1/agent/command', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ agent_id: agent, command: cmd })
                });
                if (res.ok) {
                    const data = await res.json();
                    log.innerHTML += `<div class="log-item"><div class="log-time">${time}</div><div class="log-success">✅ Dispatched: ${data.agent}</div></div>`;
                } else {
                    log.innerHTML += `<div class="log-item"><div class="log-time">${time}</div><div class="log-error">❌ Unauthorized</div></div>`;
                }
            } catch (e) {
                log.innerHTML += `<div class="log-item"><div class="log-time">${time}</div><div class="log-error">⚠️ Node-08 offline</div></div>`;
            }
            btn.disabled = false;
            btn.innerText = "🚀 Execute Command";
            log.scrollTop = log.scrollHeight;
        }
    </script>
</body>
</html>

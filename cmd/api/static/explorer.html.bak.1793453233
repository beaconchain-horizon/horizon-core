<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horizon Core Explorer</title>
    <style>
        :root { --bg: #0d1117; --bg2: #161b22; --fg: #c9d1d9; --muted: #8b949e; --accent: #58a6ff; --green: #3fb950; --red: #f85149; --border: #30363d; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--fg); margin: 0; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 15px; margin-bottom: 25px; }
        header h1 { margin: 0; font-size: 24px; color: var(--accent); }
        .status-badge { background: rgba(63, 185, 80, 0.1); color: var(--green); padding: 5px 12px; border-radius: 20px; font-size: 13px; border: 1px solid var(--green); }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px; }
        .stat-card { background: var(--bg2); padding: 20px; border-radius: 8px; border: 1px solid var(--border); }
        .stat-card h3 { margin: 0 0 10px 0; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
        .stat-card .value { font-size: 24px; font-weight: bold; color: var(--accent); }
        .table-container { background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 20px; }
        .table-header { padding: 15px 20px; border-bottom: 1px solid var(--border); font-weight: 600; display: flex; justify-content: space-between; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { padding: 12px 20px; font-size: 12px; color: var(--muted); border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.2); }
        td { padding: 12px 20px; border-bottom: 1px solid var(--border); font-size: 14px; }
        tr:last-child td { border-bottom: none; }
        tr:hover { background: rgba(88, 166, 255, 0.05); }
        .mono { font-family: monospace; color: var(--accent); }
        .badge { padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .badge-genesis { background: rgba(139, 148, 158, 0.2); color: var(--muted); }
        .badge-tx { background: rgba(88, 166, 255, 0.1); color: var(--accent); border: 1px solid var(--accent); }
        .hash { color: var(--muted); font-family: monospace; font-size: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🔭 Horizon Core Explorer</h1>
            <div class="status-badge" id="chainStatus">Connecting...</div>
        </header>
        <div class="stats-grid">
            <div class="stat-card"><h3>Chain Height</h3><div class="value" id="statHeight">-</div></div>
            <div class="stat-card"><h3>Total Transactions</h3><div class="value" id="statTxTotal">-</div></div>
            <div class="stat-card"><h3>Latest Block Hash</h3><div class="value mono" id="statHash" style="font-size:14px; word-break:break-all;">-</div></div>
            <div class="stat-card"><h3>Network TPS (est.)</h3><div class="value" id="statTps">-</div></div>
        </div>
        <div class="table-container">
            <div class="table-header"><span>Latest Blocks</span><a href="#" onclick="fetchData()" style="color:var(--accent);text-decoration:none;font-size:13px;">Refresh</a></div>
            <table>
                <thead><tr><th>Block</th><th>Age</th><th>Txns</th><th>Hash</th><th>Merkle Root</th></tr></thead>
                <tbody id="blocksTableBody"><tr><td colspan="5" style="text-align:center;color:var(--muted)">Loading...</td></tr></tbody>
            </table>
        </div>
        <div class="table-container">
            <div class="table-header"><span>Latest Transactions</span></div>
            <table>
                <thead><tr><th>TX Hash</th><th>Type</th><th>Block</th><th>Status</th></tr></thead>
                <tbody id="txTableBody"><tr><td colspan="4" style="text-align:center;color:var(--muted)">Waiting for data...</td></tr></tbody>
            </table>
        </div>
    </div>
    <script>
        const API_BASE = "http://localhost:8080/api/v1";
        async function fetchData() {
            try {
                const infoRes = await fetch(`${API_BASE}/chain/info`);
                const info = await infoRes.json();
                document.getElementById('chainStatus').innerText = `🟢 ${info.chain_id} (Online)`;
                document.getElementById('statHeight').innerText = info.height.toLocaleString();
                document.getElementById('statTxTotal').innerText = info.tx_total.toLocaleString();
                document.getElementById('statHash').innerText = info.latest_hash || "-";

                const blocksRes = await fetch(`${API_BASE}/blocks?limit=10`);
                const blocksData = await blocksRes.json();
                const blocks = blocksData.blocks || [];
                const bTbody = document.getElementById('blocksTableBody');
                bTbody.innerHTML = '';
                if (blocks.length === 0) { bTbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--muted)">No blocks found</td></tr>'; }
                let latestTxCount = 0;
                blocks.forEach(b => {
                    latestTxCount += b.tx_count;
                    const typeBadge = b.merkle_type === 'genesis' ? '<span class="badge badge-genesis">Genesis</span>' : '';
                    const timeAgo = new Date(b.timestamp * 1000).toLocaleTimeString();
                    bTbody.innerHTML += `<tr><td><b>#${b.number}</b> ${typeBadge}</td><td>${timeAgo}</td><td>${b.tx_count}</td><td class="hash">${b.block_hash.substring(0, 20)}...</td><td class="hash">${b.merkle_root.substring(0, 20)}...</td></tr>`;
                });
                document.getElementById('statTps').innerText = latestTxCount > 0 ? "High" : "0";

                const txTbody = document.getElementById('txTableBody');
                txTbody.innerHTML = '';
                if (blocks.length > 0 && blocks[0].tx_count > 0) {
                    for(let i=0; i<Math.min(blocks[0].tx_count, 5); i++) {
                        txTbody.innerHTML += `<tr><td class="mono">tx_${blocks[0].block_hash.substring(0, 15)}_${i}</td><td><span class="badge badge-tx">license_issue</span></td><td><b>#${blocks[0].number}</b></td><td style="color:var(--green)">Confirmed</td></tr>`;
                    }
                } else { txTbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--muted)">No transactions yet</td></tr>'; }
            } catch (err) {
                document.getElementById('chainStatus').innerText = `🔴 Offline`;
                document.getElementById('chainStatus').style.color = 'var(--red)';
                document.getElementById('chainStatus').style.borderColor = 'var(--red)';
            }
        }
        fetchData();
        setInterval(fetchData, 5000);
    </script>

    <div id="agent-network-section" style="display:none; padding:20px; max-width:1200px; margin:0 auto;">
        <h2 style="color:#58a6ff;">👼 Horizon Agent Network</h2>
        
        <div style="display:flex; gap:20px; margin-bottom:30px;">
            <div style="background:#161b22; padding:20px; border-radius:8px; flex:1; border:1px solid #30363d; text-align:center;">
                <h3 style="margin:0; color:#8b949e; font-size:13px; text-transform:uppercase;">Registered Agents</h3>
                <div id="agent-total" style="font-size:32px; font-weight:bold; color:#3fb950; margin-top:10px;">--</div>
            </div>
            <div style="background:#161b22; padding:20px; border-radius:8px; flex:1; border:1px solid #30363d; text-align:center;">
                <h3 style="margin:0; color:#8b949e; font-size:13px; text-transform:uppercase;">Consensus Nodes</h3>
                <div style="font-size:32px; font-weight:bold; color:#3fb950; margin-top:10px;">7</div>
            </div>
            <div style="background:#161b22; padding:20px; border-radius:8px; flex:1; border:1px solid #30363d; text-align:center;">
                <h3 style="margin:0; color:#8b949e; font-size:13px; text-transform:uppercase;">Consensus Hash</h3>
                <div style="font-size:18px; font-weight:bold; color:#3fb950; margin-top:16px;">3ac449e0...</div>
            </div>
        </div>
        
        <h3 style="color:#fff; border-bottom:1px solid #30363d; padding-bottom:10px;">Agent Registry</h3>
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:14px;">
            <thead>
                <tr style="border-bottom:1px solid #30363d; color:#8b949e;">
                    <th style="padding:12px;">Agent ID</th>
                    <th style="padding:12px;">Name</th>
                    <th style="padding:12px;">Role / Description</th>
                    <th style="padding:12px;">Status</th>
                </tr>
            </thead>
            <tbody id="agent-list" style="color:#c9d1d9;"></tbody>
        </table>
        <div style="text-align:center; margin-top:20px; color:#8b949e; font-size:12px;">
            Showing first 50 agents for security and performance.
        </div>
    </div>

    <script>
        async function showAgents() {
            // مخفی کردن تمام بخش‌های اصلی صفحه
            document.querySelectorAll('section, .cards, .blocks-container').forEach(el => el.style.display = 'none');
            
            // نمایش بخش ایجنت‌ها
            document.getElementById('agent-network-section').style.display = 'block';
            
            try {
                const res = await fetch('http://localhost:8080/api/v1/agents/status');
                const data = await res.json();
                
                document.getElementById('agent-total').innerText = data.total_registered;
                
                let html = '';
                // نمایش 50 ایجنت اول برای جلوگیری از سنگین شدن صفحه
                data.agents.slice(0, 50).forEach(a => {
                    html += '<tr style="border-bottom:1px solid #21262d; transition:background 0.2s;">' +
                        '<td style="padding:12px; font-family:monospace;">' + a.id + '</td>' +
                        '<td style="padding:12px; font-weight:bold;">' + a.name + '</td>' +
                        '<td style="padding:12px; color:#8b949e;">' + (a.description || "Specialized AI Agent") + '</td>' +
                        '<td style="padding:12px; color:#3fb950; font-weight:bold;">● Active</td></tr>';
                });
                document.getElementById('agent-list').innerHTML = html;
            } catch(e) {
                document.getElementById('agent-list').innerHTML = '<tr><td colspan="4" style="color:#f85149; text-align:center; padding:20px;">❌ Failed to connect to Agent API.</td></tr>';
            }
        }
    </script>

</body>
</html>

# ============================================================
# Horizon Core · Backend
# Go 1.24 · Linux amd64 · CGO disabled
# ============================================================

FROM golang:1.24-alpine AS builder

WORKDIR /app

ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=amd64
ENV GOTOOLCHAIN=local
ENV GOWORK=off

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN go build \
    -trimpath \
    -buildvcs=false \
    -ldflags="-s -w" \
    -o /horizon-backend \
    ./cmd/api


# ============================================================
# Runtime
# ============================================================

FROM alpine:3.24

RUN apk add --no-cache \
      ca-certificates \
      tzdata \
      curl \
    && addgroup -g 10001 horizon \
    && adduser -D -u 10001 -G horizon horizon

WORKDIR /app

ENV GIN_MODE=release
ENV SERVER_PORT=8080

COPY --from=builder /horizon-backend /app/horizon-backend

RUN chown horizon:horizon /app/horizon-backend

USER horizon

EXPOSE 8080

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=20s \
    --retries=5 \
    CMD curl -fsS \
      http://127.0.0.1:8080/api/v1/health \
      || exit 1

ENTRYPOINT ["/app/horizon-backend"]

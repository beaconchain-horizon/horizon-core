package main

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gin-gonic/gin"
)

func setupTestRouter(t *testing.T) *gin.Engine {
	t.Helper()
	gin.SetMode(gin.TestMode)
	r := gin.New()
	r.Use(bodyLimitMiddleware())
	r.POST("/echo", func(c *gin.Context) {
		c.JSON(http.StatusOK, gin.H{"ok": true})
	})
	return r

func TestBodyLimit_AcceptsSmallBody(t *testing.T) {
	r := setupTestRouter(t)
	body := strings.NewReader(`{"msg":"hello"}`)
	req := httptest.NewRequest(http.MethodPost, "/echo", body)
	req.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req)
	if w.Code != http.StatusOK {
		t.Fatalf("small body should be accepted, got %d", w.Code)
	}
}

func TestBodyLimit_RejectsOversizedBodyByContentLength(t *testing.T) {
	r := setupTestRouter(t)
	huge := strings.Repeat("A", 9<<20) // 9 MiB > 8 MiB default
	req := httptest.NewRequest(http.MethodPost, "/echo", strings.NewReader(huge))
	req.Header.Set("Content-Type", "application/json")
	w := httptest.NewRecorder()
	r.ServeHTTP(w, req)
	if w.Code != http.StatusRequestEntityTooLarge {
	}
	if !strings.Contains(w.Body.String(), "request body too large") {
		t.Fatalf("unexpected error body: %s", w.Body.String())
}

func TestBodyLimit_RejectsOversizedChunkedBody(t *testing.T) {
	// on MaxBytesReader to stop the read.
	r := setupTestRouter(t)
	huge := strings.Repeat("A", 9<<20)
	req.ContentLength = -1
	req.Header.Set("Content-Type", "application/json")
	w := httptest.NewRecorder()
	r.ServeHTTP(w, req)
	// Either 413 at middleware, or 400 from JSON decode after truncated read.
	if w.Code != http.StatusRequestEntityTooLarge && w.Code != http.StatusBadRequest {
	}
}

func TestBodyLimit_AllowsAtLimit(t *testing.T) {
	r := setupTestRouter(t)
	exact := strings.Repeat("A", 8<<20)
	req := httptest.NewRequest(http.MethodPost, "/echo", strings.NewReader(exact))
	w := httptest.NewRecorder()
	if w.Code != http.StatusOK {
		t.Fatalf("body at limit should be accepted, got %d", w.Code)
}

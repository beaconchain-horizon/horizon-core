<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>داشبورد Horizon Core</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;700;900&display=swap');
        body { font-family: 'Vazirmatn', sans-serif; background: #0f172a; }
        .glass { background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.05); }
        .gradient-text { background: linear-gradient(135deg, #38bdf8, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .card-hover:hover { transform: translateY(-4px); transition: all 0.3s ease; box-shadow: 0 20px 40px -15px rgba(56, 189, 248, 0.2); }
        .spinner { border: 3px solid rgba(255,255,255,0.1); border-radius: 50%; border-top: 3px solid #38bdf8; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 20px auto; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="text-gray-200 p-6 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 border-b border-gray-800 pb-4">
            <div>
                <h1 class="text-3xl md:text-4xl font-black gradient-text">🔭 Horizon Core</h1>
                <p class="text-gray-400 text-sm mt-1">داشبورد زنده مخزن <span class="text-cyan-400 font-bold">beaconchain-horizon/horizon-core</span></p>
            </div>
            <div class="mt-2 md:mt-0 flex items-center gap-3 text-xs bg-gray-800 px-4 py-2 rounded-full">
                <i class="fas fa-database text-cyan-400"></i>
                <span>داده‌ها از GitHub API</span>
                <span class="w-1 h-1 bg-gray-600 rounded-full"></span>
                <span id="update-time" class="text-gray-400">بارگذاری...</span>
            </div>
        </div>

        <!-- کارت‌های خلاصه -->
        <div id="summary-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
            <div class="glass rounded-2xl p-6 card-hover"><div class="spinner"></div></div>
            <div class="glass rounded-2xl p-6 card-hover"><div class="spinner"></div></div>
            <div class="glass rounded-2xl p-6 card-hover"><div class="spinner"></div></div>
            <div class="glass rounded-2xl p-6 card-hover"><div class="spinner"></div></div>
        </div>

        <!-- جزئیات مخزن -->
        <div class="glass rounded-2xl p-6 card-hover">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold flex items-center gap-2">
                    <i class="fas fa-code-branch text-purple-400"></i> جزئیات مخزن
                </h2>
                <a id="repo-link" href="#" target="_blank" class="text-xs bg-blue-600 hover:bg-blue-700 px-3 py-1 rounded-full transition">
                    مشاهده در گیت‌هاب
                </a>
            </div>
            <div id="repo-details" class="text-sm space-y-2">
                <div class="spinner"></div>
            </div>
        </div>

        <div class="mt-8 text-center text-gray-600 text-xs border-t border-gray-800 pt-6">
            ساخته شده برای <span class="text-gray-400">Horizon Core</span> | داده‌ها به‌صورت زنده از گیت‌هاب
        </div>
    </div>

    <script>
        const REPO_OWNER = 'beaconchain-horizon';
        const REPO_NAME = 'horizon-core';
        const API_BASE = `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}`;

        async function fetchData() {
            try {
                const res = await fetch(API_BASE);
                if (!res.ok) throw new Error('مخزن یافت نشد یا دسترسی محدود است');
                const repo = await res.json();

                // بروزرسانی زمان
                document.getElementById('update-time').innerHTML = `<i class="far fa-clock ml-1"></i> ${new Date().toLocaleString('fa-IR')}`;

                // لینک گیت‌هاب
                const repoLink = document.getElementById('repo-link');
                repoLink.href = repo.html_url;

                // کارت‌های خلاصه
                const cardsData = [
                    { icon: 'fa-star', label: 'ستاره‌ها', value: repo.stargazers_count.toLocaleString(), color: 'text-yellow-400' },
                    { icon: 'fa-code-fork', label: 'فورک‌ها', value: repo.forks_count.toLocaleString(), color: 'text-green-400' },
                    { icon: 'fa-exclamation-triangle', label: 'Issues باز', value: repo.open_issues_count.toLocaleString(), color: 'text-red-400' },
                    { icon: 'fa-code', label: 'زبان اصلی', value: repo.language || 'نامشخص', color: 'text-purple-400' }
                ];
                document.getElementById('summary-cards').innerHTML = cardsData.map(item => `
                    <div class="glass rounded-2xl p-6 card-hover flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gray-800/50 flex items-center justify-center text-2xl ${item.color}">
                            <i class="fas ${item.icon}"></i>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs">${item.label}</p>
                            <p class="text-2xl font-bold text-white">${item.value}</p>
                        </div>
                    </div>
                `).join('');

                // جزئیات مخزن
                const details = `
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div><span class="text-gray-400">نام کامل:</span> <span class="text-white font-mono">${repo.full_name}</span></div>
                        <div><span class="text-gray-400">توضیحات:</span> <span class="text-gray-300">${repo.description || 'بدون توضیحات'}</span></div>
                        <div><span class="text-gray-400">شاخه پیش‌فرض:</span> <span class="text-cyan-400">${repo.default_branch}</span></div>
                        <div><span class="text-gray-400">آخرین بروزرسانی:</span> <span class="text-gray-300">${new Date(repo.updated_at).toLocaleDateString('fa-IR')}</span></div>
                        <div><span class="text-gray-400">تاریخ ایجاد:</span> <span class="text-gray-300">${new Date(repo.created_at).toLocaleDateString('fa-IR')}</span></div>
                        <div><span class="text-gray-400">مجوز:</span> <span class="text-gray-300">${repo.license ? repo.license.name : 'نامشخص'}</span></div>
                        <div><span class="text-gray-400">حجم:</span> <span class="text-gray-300">${(repo.size / 1024).toFixed(1)} MB</span></div>
                        <div><span class="text-gray-400">آدرس Clone:</span> <span class="text-gray-300 font-mono text-xs">${repo.clone_url}</span></div>
                    </div>
                `;
                document.getElementById('repo-details').innerHTML = details;

            } catch (error) {
                document.getElementById('repo-details').innerHTML = `
                    <div class="text-center py-6 text-red-400">
                        <i class="fas fa-exclamation-circle"></i> خطا: ${error.message || 'مشکل در اتصال به GitHub API'}
                        <br><span class="text-gray-500 text-xs">ممکن است محدودیت درخواست (Rate Limit) رخ داده باشد.</span>
                    </div>
                `;
                document.getElementById('update-time').innerHTML = '❌ خطا در بارگذاری';
                console.error(error);
            }
        }

        fetchData();
    </script>
</body>
</html>

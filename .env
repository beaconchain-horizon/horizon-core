# Horizon Core — Environment Variables
# این فایل فقط لوکال است. git از آن صرف‌نظر می‌کند.

# Switch
SWITCH_PORT=8080
SWITCH_DB=/root/data/horizon-switch.db
CHAIN_CONFIG=/root/data/chain.json
CUSTOMERS_CONFIG=/root/data/customers.json
HEARTBEAT_SEC=30

# Backend
BACKEND_PORT=8080
POSTGRES_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql://horizon_app:<CHANGE_ME>@horizon:5432/horizon_db

# Auth
ADMIN_TOKEN=<CHANGE_ME>
API_KEY=<CHANGE_ME>

# License / Crypto
HORIZON_LICENSE_PUBLIC_KEY=<CHANGE_ME>
HORIZON_HARDWARE_ID=<CHANGE_ME>

# Switch Connection
SWITCH_URL=http://localhost:8091
ENABLE_SWITCH=true

# Runtime
GIN_MODE=release
NODE_ENV=production

# AI (optional)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_ID=

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
HORIZON_API_URL=http://localhost:8080
HORIZON_SWITCH_URL=http://localhost:8091

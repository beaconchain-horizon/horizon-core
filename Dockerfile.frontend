FROM node:25-alpine AS deps
WORKDIR /app
COPY frontend/package.json ./package.json
RUN npm install --no-audit --no-fund

FROM node:25-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:25-alpine AS runner
RUN apk add --no-cache curl && addgroup -S nextjs && adduser -S -G nextjs nextjs
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder --chown=nextjs:nextjs /app/ ./
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD curl -fsS http://127.0.0.1:3000/angel/login || exit 1
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0"]

FROM golang:1.24-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 horizon \
    && adduser -S -D -H -u 10001 -G horizon horizon

WORKDIR /app
COPY --from=builder --chown=horizon:horizon /out/api /app/api

ENV GIN_MODE=release

EXPOSE 8080
USER horizon:horizon
ENTRYPOINT ["/app/api"]

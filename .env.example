# Horizon Core v1.4 — local development template
# Preferred setup: bash scripts/bootstrap-horizon-v14.sh
# This file intentionally contains no reusable passwords or key material.

# Generated by the bootstrap script; required by Docker Compose.
POSTGRES_PASSWORD=
ADMIN_TOKEN=
API_KEY=

# Generated from the Authority keypair, and passed only to Switch.
AUTHORITY_PROTOCOL_VERSION=v1.4-secp256k1
HORIZON_LICENSE_PUBLIC_KEY=
# Optional stable identity for cloud/VM deployments when DMI UUID is unavailable.
HORIZON_HARDWARE_ID=
ANGEL_ADMIN_PASSWORD=
ANGEL_SESSION_SECRET=

# Backend is server-side only; do not put API_KEY or ADMIN_TOKEN into browser JavaScript.
LICENSE_PRIVATE_KEY_FILE=/run/horizon/issuer-private.pem
SWITCH_URL=http://switch:8080
ENABLE_SWITCH=true

# Optional AI gateway settings; leave empty unless explicitly configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_ID=

# Optional frontend server-side settings. Do not prefix private secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=
HORIZON_API_URL=
HORIZON_SWITCH_URL=
HORIZON_ORDER_API=
HORIZON_ORDER_API_KEY=

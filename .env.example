# ============================================================
# Horizon Core v1.4 — Backend Environment Template
# ============================================================
# این فایل فقط placeholder است. هیچ مقدار واقعی در آن نیست.
# مقادیر واقعی را در Liara Dashboard → Environment Variables
# یا در فایل .env محلی (که در .gitignore است) بگذار.
# ============================================================

# ─── Identity ────────────────────────────────────────────────
GIN_MODE=release

# ─── HTTP Server ─────────────────────────────────────────────
# پورت listen. روی Liara معمولاً 8080.
SERVER_PORT=8080

# ─── Auth (Fail-Closed) ──────────────────────────────────────
# ADMIN_TOKEN: حداقل ۳۲ کاراکتر. Backend بدون این بالا نمی‌آید.
# تولید: openssl rand -hex 32
ADMIN_TOKEN=

# API_KEY اختیاری. اگر باشد، جایگزین ADMIN_TOKEN می‌شود.
API_KEY=

# ─── Database ────────────────────────────────────────────────
# DSN اتصال Postgres.
# قالب: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# ─── Signing Key (secp256k1) ─────────────────────────────────
# کلید خصوصی امضای لایسنس. فقط در Authority / Backend.
# هرگز در مرورگر، فرانت، یا repo قرار نده.
# قالب: PEM چندخطی با header HORIZON SECP256K1 PRIVATE KEY
# تولید: go run ./cmd/horizon-keygen  یا  ابزار تأییدشده Authority
LICENSE_PRIVATE_KEY_PEM=

# ─── Switch Integration ──────────────────────────────────────
# اگر true باشد، Backend لایسنس‌ها را به Switch می‌فرستد.
ENABLE_SWITCH=true

# آدرس Switch. روی Liara معمولاً https://horizon-switch.liara.run
SWITCH_URL=

# توکن ادمین Switch. باید با ADMIN_TOKEN در سرویس Switch یکی باشد.
SWITCH_ADMIN_TOKEN=

# ─── AI Provider (اختیاری) ───────────────────────────────────
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_ID=

# ─── Hardware Binding (اختیاری، فقط برای تست لوکال) ──────────
# در production معمولاً خالی می‌ماند.
HORIZON_HARDWARE_ID=

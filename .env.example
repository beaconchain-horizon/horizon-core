# ═══════════════════════════════════════════════════════
#  Horizon Core — Environment Variables
#  کپی کن به .env و مقادیر واقعی رو بذار
#  .env در .gitignore هست و push نمی‌شه
# ═══════════════════════════════════════════════════════

# ─── Postgres (backend) ───
POSTGRES_PASSWORD=change-me-to-strong-random-password

# ─── Admin API ───
# تولید: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-64-char-hex
API_KEY=change-me-to-64-char-hex

# ─── Switch ───
SWITCH_PORT=8080
GIN_MODE=release

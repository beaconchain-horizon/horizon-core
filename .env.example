# ==================================================================
# Horizon Core Engine - Environment Variables
# ==================================================================
# Server Configuration
SERVER_PORT=8080

# Database (Hybrid: PostgreSQL for online, SQLite for offline cache)
# ⚠️ اینجا را با رمز واقعی دیتابیس خودت پر کن، اما هرگز در گیت‌هاب نگذار!
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=disable
DB_PATH=./horizon-core.db

# Security & Authentication
# ⚠️ این مقادیر باید توکن‌های امن و تصادفی باشند (در لیارا تنظیم می‌شوند)
ADMIN_TOKEN=your_secure_admin_token_here
API_KEY=your_secure_api_key_here

# External APIs (Optional - for future integrations)
BEACONCHAIN_API_URL=https://api.beaconcha.in/api/v1
BEACONCHAIN_API_KEY=your_api_key_here

# Webhook & GitHub Integration (Optional)
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=your_github_personal_access_token

# AI Services (Optional - reserved for future use)
AI_BASE_URL=https://ai.liara.ir/api/6a93f2f35209e715fd305ca9/v1
AI_API_KEY=your_liara_ai_api_key_here
AI_MODEL_ID=openai/gpt-5.1-codex-mini
